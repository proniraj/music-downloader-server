# Logging
LOG_LEVEL=INFO

# --- YouTube Music (ytmusicapi) ---
# Personalized home ("Your morning music") requires auth.
# OAuth is currently broken server-side — use browser auth instead.
# See: https://github.com/sigma67/ytmusicapi/issues/813

# Auth mode: auto (default), browser, oauth, or none
YTMUSIC_AUTH=auto

# Browser auth (recommended) — https://ytmusicapi.readthedocs.io/en/stable/setup/browser.html
# 1. Open https://music.youtube.com while logged in
# 2. DevTools → Network → any /browse request → copy Request Headers
# 3. Run: ytmusicapi browser --file browser.json
YTMUSIC_BROWSER_FILE=browser.json

# OAuth (often returns HTTP 400 from YouTube Music — kept for when Google fixes it)
# YTMUSIC_OAUTH_FILE=oauth.json
# YTMUSIC_CLIENT_ID=your-client-id.apps.googleusercontent.com
# YTMUSIC_CLIENT_SECRET=your-client-secret

# Optional brand account ID (21-digit number from myaccount.google.com)
# YTMUSIC_BRAND_ACCOUNT_ID=
