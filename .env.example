# Logging
LOG_LEVEL=INFO

# --- YouTube Music (ytmusicapi) ---
# Optional. Without auth, public endpoints like mood-categories still work.
# Personalized home rows ("Your morning music", etc.) need authentication.

# OAuth (recommended) — see https://ytmusicapi.readthedocs.io/en/stable/setup/oauth.html
# 1. In Google Cloud Console, create OAuth client ID → "TVs and Limited Input devices"
# 2. Run: ytmusicapi oauth
# 3. Set the values below:
YTMUSIC_OAUTH_FILE=oauth.json
YTMUSIC_CLIENT_ID=1079393289119-0ortr5g8207dosrl97brqnoa0o2ok341.apps.googleusercontent.com
YTMUSIC_CLIENT_SECRET=your-client-secret

# Browser auth alternative — see https://ytmusicapi.readthedocs.io/en/stable/setup/browser.html
# YTMUSIC_BROWSER_FILE=browser.json

# Optional brand account ID (21-digit number from myaccount.google.com)
# YTMUSIC_BRAND_ACCOUNT_ID=
